    "world_size": 16,
    "attention_policy": "head_shard",
    "mlp_policy": "colrow_shard",
    "attention_policy_front": "head_shard",
    "attention_policy_mid": "head_shard",
    "attention_policy_back": "head_shard",
    "mlp_policy_front": "colrow_shard",
    "mlp_policy_mid": "colrow_shard",
    "mlp_policy_back": "colrow_shard",
    "embedding_policy": "vocab_shard",
    "lm_head_policy": "vocab_shard",
    "sequence_parallel": true,
    "micro_batch_size": 1,
    "global_batch_size": 4,
    "parallel_mode": "MODEL_PARALLEL",
    "execution_mode": "current_feasible",
    "strategy_name": "BLOCK_LEVEL_FAST",
    "strategy_policy": "BALANCED",
    "search_time_seconds": 0.012530320789664984,
    "estimated_memory_bytes": 40945733597,
    "memory_margin_bytes": 22276185000,
    "fits_current_environment": true,
    "requires_additional_devices": 0,
    "megatron_lowerable": true,
    "notes": [
